# Internal ingress for the kajet stack. Keeps the host proxy unaware of the
# MCP/API split: it only needs Host -> this service.
#
# Listen on both :80 and :8000. The caddy image exposes 80/443/2019 on top of
# our 8000, so the host Traefik (which gets no explicit loadbalancer port from
# Coolify) targets the lowest exposed port (80) in production, while local dev
# hits 8000. Both are plain HTTP (TLS is terminated upstream).
#
# MCP is stateful and single-process (kajet-mcp); everything else is the
# stateless API + SPA (kajet-api). Caddy streams text/event-stream responses by
# default, which the MCP StreamableHTTP transport relies on.
:80, :8000 {
	@mcp path /mcp /mcp/* /authorize* /token* /register* /revoke* /.well-known/*
	@api path /api /api/* /healthz /readyz
	@docs path /docs /docs/* /redoc /redoc/* /openapi.json
	@non_static_method not method GET HEAD

	@spa_root {
		method GET HEAD
		header Accept *text/html*
		path /
	}
	@spa_navigation {
		method GET HEAD
		header Accept *text/html*
		path_regexp ^/(?:.*/)?[^./][^/.]*/*$
		not path_regexp (^|/)\.[^/]+
	}
	@workspace_notes_navigation {
		method GET HEAD
		header Accept *text/html*
		path_regexp ^/workspace/[A-Za-z0-9][A-Za-z0-9_-]{0,49}/notes/.+$
		not path_regexp (^|/)\.[^/]+
	}

	# Baseline response security headers (#92), applied to every response this
	# server writes — static SPA files, the @mcp/@api reverse proxies, and
	# Caddy's own file_server 404s for scanner probes (#45) alike. No `defer`
	# needed: kajet-api/kajet-mcp never set these header names themselves, so
	# there's no upstream value to race — confirmed against reverse_proxy
	# locally, where deferring instead dropped these off file_server's error
	# responses entirely (Caddy's error path writes fresh, bypassing deferred
	# header ops registered on the normal response chain).
	#
	# No Strict-Transport-Security here. Caddy only ever speaks plain HTTP on
	# :80/:8000 — TLS terminates at the host Traefik/Coolify proxy upstream of
	# this container — so Caddy has no visibility into the public domain,
	# certs, or subdomains an HSTS policy needs to be scoped against; that
	# context lives entirely at the host layer, which is where the decision
	# belongs. Whether Traefik/Coolify already sends HSTS on the production
	# domain is unverified as of #92 — check and add it there if not, rather
	# than duplicating a policy this repo can't fully see into.
	#
	# CSP script-src/style-src carry hashes for the two bits of inline content
	# SvelteKit's static output needs allowed — the hydration bootstrap script
	# and the #svelte-announcer a11y live region's style attribute (needs
	# 'unsafe-hashes' since CSP hashes don't cover attributes by default).
	# Baked in at image build time by the Dockerfile (see write-csp-hash.js) —
	# the placeholders below never reach a running container.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' '__CSP_SCRIPT_HASH__'; style-src 'self' 'unsafe-hashes' '__CSP_STYLE_HASH__'; img-src 'self' https: data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# Keep route order explicit: public backend routes must win before static files.
	route {
		handle @mcp {
			reverse_proxy kajet-mcp:8000
		}
		handle @api {
			reverse_proxy kajet-api:8000
		}
		handle @docs {
			respond 404
		}
		handle @non_static_method {
			respond 404
		}
		handle @spa_root {
			root * /srv
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
		handle @spa_navigation {
			root * /srv
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
		handle @workspace_notes_navigation {
			root * /srv
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
		handle {
			root * /srv
			@immutable_assets path /_app/immutable/*
			header @immutable_assets Cache-Control "public, max-age=31536000, immutable"
			@index path /index.html
			header @index Cache-Control "no-cache"
			file_server
		}
	}
}
